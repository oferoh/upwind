{
  "datasets": [
    {
      "config": {
        "comment": "Top 10 customers by lifetime spend (cancelled orders excluded upstream)",
        "dimensions": [
          {
            "expr": "customer_name",
            "name": "customer_name"
          }
        ],
        "measures": [
          {
            "expr": "SUM(total_spent)",
            "format": {
              "abbreviation": "compact",
              "currencyCode": "USD",
              "type": "currency"
            },
            "name": "total_spent"
          }
        ],
        "source": "SELECT customer_name, total_spent FROM customers ORDER BY total_spent DESC LIMIT 10\n",
        "version": "1.1"
      },
      "displayName": "Top 10 Customers by Spend",
      "name": "top_customers"
    },
    {
      "config": {
        "comment": "Customer-base KPIs over the gold customers table (per-customer aggregates; cancelled orders excluded from total_spent upstream)",
        "dimensions": [
          {
            "expr": "city",
            "name": "city"
          }
        ],
        "measures": [
          {
            "expr": "COUNT(DISTINCT customer_id)",
            "name": "customer_count"
          },
          {
            "expr": "SUM(total_spent)",
            "format": {
              "abbreviation": "compact",
              "currencyCode": "USD",
              "type": "currency"
            },
            "name": "total_spend_all_customers",
            "synonyms": [
              "revenue"
            ]
          }
        ],
        "source": "customers",
        "version": "1.1"
      },
      "displayName": "Customer Metrics",
      "name": "customer_metrics"
    },
    {
      "config": {
        "comment": "Sales metrics over the gold order_items fact table (line-level, denormalized with product, supplier, and order attributes)",
        "dimensions": [
          {
            "expr": "order_date",
            "name": "order_date"
          },
          {
            "expr": "DATE_TRUNC('MONTH', order_date)",
            "format": {
              "dateFormat": "locale_short_month",
              "type": "date"
            },
            "name": "order_month"
          },
          {
            "expr": "category",
            "name": "category"
          },
          {
            "expr": "product_name",
            "name": "product_name"
          },
          {
            "expr": "supplier_name",
            "name": "supplier_name"
          },
          {
            "expr": "country",
            "name": "country"
          },
          {
            "expr": "status",
            "name": "status"
          }
        ],
        "measures": [
          {
            "expr": "SUM(total_amount)",
            "format": {
              "abbreviation": "compact",
              "currencyCode": "USD",
              "type": "currency"
            },
            "name": "revenue",
            "synonyms": [
              "sales"
            ]
          },
          {
            "expr": "COUNT(DISTINCT order_id)",
            "name": "order_count"
          },
          {
            "expr": "SUM(quantity)",
            "name": "units_sold"
          },
          {
            "expr": "AVG(unit_price)",
            "format": {
              "currencyCode": "USD",
              "type": "currency"
            },
            "name": "avg_unit_price"
          }
        ],
        "source": "order_items",
        "version": "1.1"
      },
      "displayName": "Order Item Metrics",
      "name": "order_items_metrics"
    },
    {
      "config": {
        "comment": "Top 10 products by total revenue across all orders",
        "dimensions": [
          {
            "expr": "product_name",
            "name": "product_name"
          }
        ],
        "measures": [
          {
            "expr": "SUM(revenue)",
            "format": {
              "abbreviation": "compact",
              "currencyCode": "USD",
              "type": "currency"
            },
            "name": "revenue"
          }
        ],
        "source": "SELECT product_name, SUM(total_amount) AS revenue FROM order_items GROUP BY product_name ORDER BY revenue DESC LIMIT 10\n",
        "version": "1.1"
      },
      "displayName": "Top 10 Products by Revenue",
      "name": "top_products"
    }
  ],
